FROM registry.redhat.io/ubi9/nodejs-22 AS web-builder

USER 0

ENV HUSKY=0 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

RUN dnf install -y \
    alsa-lib \
    at-spi2-atk \
    at-spi2-core \
    atk \
    cairo \
    cups-libs \
    dbus-libs \
    fontconfig \
    freetype \
    glib2 \
    google-droid-sans-fonts \
    libdrm \
    libX11 \
    libxcb \
    libXcomposite \
    libXdamage \
    libXext \
    libXfixes \
    libxkbcommon \
    libXrandr \
    mesa-libgbm \
    nspr \
    nss \
    pango && \
    dnf clean all

WORKDIR /usr/src/app

COPY web/package*.json web/
COPY Makefile Makefile

RUN make install-frontend-ci

RUN cd web && npx --no-install playwright install chromium

COPY web/. web/.
COPY scripts/. scripts/.

RUN chown -R 1001:0 /usr/src/app /opt/app-root/src/.npm /opt/playwright && \
    chmod -R g=u /usr/src/app /opt/app-root/src/.npm /opt/playwright

USER 1001

ENTRYPOINT ["make", "lint-frontend"]
