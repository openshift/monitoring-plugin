  "overrides": {
    "echarts": "^5.6.0",
    "qs": "6.16.0",
    "dompurify": "3.4.13",
    "fast-uri": "3.1.7",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "postcss-selector-parser": "7.1.3",
    "shell-quote": "1.9.0"
  },
  "consolePlugin": {
    "name": "monitoring-plugin",
    "version": "1.0.0",
    "displayName": "OpenShift console monitoring plugin",
    "description": "This plugin adds the monitoring UI to the OpenShift web console",
    "exposedModules": {
      "DashboardListPage": "./features/perses-dashboards/pages/dashboard-list-page/DashboardListPage",
      "DashboardPage": "./features/perses-dashboards/pages/dashboard-page/DashboardPage",
      "LegacyDashboardsPage": "./features/legacy-dashboards/pages/LegacyDashboardPage",
      "SilencesPage": "./features/alerts/pages/silences-page/SilencesPage",
      "SilencesDetailsPage": "./features/alerts/pages/SilencesDetailsPage",
      "SilenceCreatePage": "./features/alerts/pages/SilenceCreatePage",
      "SilenceEditPage": "./features/alerts/pages/SilenceEditPage",
      "MetricsPage": "./features/metrics/pages/MetricsPage",
      "AlertsPage": "./features/alerts/pages/alerts-page/AlertsPage",
      "AlertingPage": "./features/alerts/pages/AlertingPage",
      "AlertsDetailsPage": "./features/alerts/pages/AlertsDetailsPage",
      "AlertRulesPage": "./features/alerts/pages/alert-rules-page/AlertRulesPage",
      "AlertRulesDetailsPage": "./features/alerts/pages/AlertRulesDetailsPage",
      "MonitoringReducer": "./shared/store/reducers",
      "IncidentsPage": "./features/incidents/pages/IncidentsPage",
      "TargetsPage": "./features/targets/pages/TargetsPage",
      "PrometheusRedirectPage": "./features/metrics/pages/PrometheusRedirectPage",
      "MonitoringContext": "./shared/contexts/MonitoringContext",
      "ols-tool-ui": "./features/perses-dashboards/ols-tool-ui/ShowTimeseries"
    },
    "dependencies": {
      "@console/pluginAPI": "*"
    }
  }
}
